expression 'Despesas BigQuery' = ```
		let
		    Fonte = GoogleBigQuery.Database(),
		    AcessarProjeto = Fonte{[Name="dashboard-governo"]}[Data],
		    ExecutarSQL = Value.NativeQuery(
		        AcessarProjeto, 
		        "SELECT 
		        
		        ano,
		        mes,
		        sigla_uf,
		
		        -- Função (núcleo da análise de infraestrutura)
		        id_funcao,        nome_funcao,
		        id_subfuncao,     nome_subfuncao,
		
		        -- Órgão
		        id_orgao_superior,      nome_orgao_superior,
		        id_orgao_subordinado,   nome_orgao_subordinado,
		
		        -- Classificação econômica (essencial p/ isolar investimento)
		        id_categoria_economica, nome_categoria_economica,
		        id_grupo_despesa,       nome_grupo_despesa,
		        id_elemento_despesa,    nome_elemento_despesa,
		
		        -- Programa (opcional, útil)
		        id_programa_orcamentario, nome_programa_orcamentario,
		        id_acao,                  nome_acao,
		
		        -- Métricas
		        valor_empenhado,
		        valor_liquidado,
		        valor_pago
		        FROM `basedosdados.br_cgu_despesas_publicas.execucao`",
		        null,
		        [EnableFolding=true]
		    )
		in
		    ExecutarSQL
		```
	lineageTag: e2368906-67cd-4fd3-9e88-5cb6b4986362

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

