		summarizeBy: none
		sourceColumn: Foto

		annotation SummarizationSetBy = Automatic

	partition dim_Presidentes = m
		mode: import
		source = ```
				let
				    Query = "SELECT ?presidente ?presidenteLabel ?inicio ?fim ?partidoLabel ?foto WHERE {
				  ?presidente p:P39 ?mandato .
				  ?mandato ps:P39 wd:Q5176750 ;
				           pq:P580 ?inicio .
				  OPTIONAL { ?mandato pq:P582 ?fim . }
				  OPTIONAL { ?presidente wdt:P102 ?partido . }
				  OPTIONAL { ?presidente wdt:P18 ?foto . }
				  SERVICE wikibase:label { bd:serviceParam wikibase:language ""pt,en"". }
				}
				ORDER BY ?inicio",
				    
				    Url = "https://query.wikidata.org/sparql?query=" & Uri.EscapeDataString(Query) & "&format=json",
				    
				    Fonte = Json.Document(Web.Contents(Url)),
				    
				    Resultados = Fonte[results][bindings],
				    
				    ParaTabela = Table.FromList(Resultados, Splitter.SplitByNothing(), null, null, ExtraValues.Error),
				  #"Expandido Column1" = Table.ExpandRecordColumn(ParaTabela, "Column1", {"presidenteLabel", "inicio", "fim", "partidoLabel", "foto"}, {"Presidente", "Inicio", "Fim", "Partido", "Foto"}),
				    
				    ExtrairPresidente = Table.TransformColumns(#"Expandido Column1", {"Presidente", each _[value], type text}),
				    ExtrairInicio = Table.TransformColumns(ExtrairPresidente, {"Inicio", each _[value], type text}),
				    ExtrairFim = Table.TransformColumns(ExtrairInicio, {"Fim", each if _ = null then null else _[value], type text}),
				    ExtrairPartido = Table.TransformColumns(ExtrairFim, {"Partido", each if _ = null then null else _[value], type text}),
				  #"Expandido Foto" = Table.ExpandRecordColumn(ExtrairPartido, "Foto", {"value"}, {"Foto"}),
				    
				    ConverterInicio = Table.TransformColumns(#"Expandido Foto", {{"Inicio", each DateTime.Date(DateTime.FromText(_, [Format="yyyy-MM-ddTHH:mm:ssZ"])), type date}}),
				    ConverterFim = Table.TransformColumns(ConverterInicio, {{"Fim", each if _ = null then null else DateTime.Date(DateTime.FromText(_, [Format="yyyy-MM-ddTHH:mm:ssZ"])), type date}}),
				    
				    SubstituirFimNulo = Table.ReplaceValue(ConverterFim, null, Date.From(DateTime.LocalNow()), Replacer.ReplaceValue, {"Fim"}),
				    
				    #"Colocar Cada Palavra Em Maiúscula" = Table.TransformColumns(SubstituirFimNulo,{{"Partido", Text.Proper, type text}})
				in
				    #"Colocar Cada Palavra Em Maiúscula"
				```

	changedProperty = IsHidden

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

